{
  "name": "mindcompanion",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mindcompanion",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "workers/*"
      ],
      "engines": {
        "node": "24.x"
      }
    },
    "apps/bot": {
      "name": "@mindcompanion/bot",
      "version": "0.1.0"
    },
    "node_modules/@mindcompanion/bot": {
      "resolved": "apps/bot",
      "link": true
    },
    "node_modules/@mindcompanion/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@mindcompanion/nightly-worker": {
      "resolved": "workers/nightly",
      "link": true
    },
    "packages/core": {
      "name": "@mindcompanion/core",
      "version": "0.1.0"
    },
    "workers/nightly": {
      "name": "@mindcompanion/nightly-worker",
      "version": "0.1.0"
    }
  }
}
