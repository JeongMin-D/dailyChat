# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
APP_TIMEZONE=Asia/Seoul
DAY_BOUNDARY_HOUR=4
DIARY_FINAL_TIME=04:05
NIGHTLY_PIPELINE_VERSION=nightly-pipeline-v1
# Optional manual replay target. Leave empty for the last closed local day.
NIGHTLY_TARGET_DAY=
HTTP_BODY_LIMIT_BYTES=1048576
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_RETRY_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_DELAY_MS=250
UPSTREAM_RETRY_MAX_DELAY_MS=2000
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_CONTEXT_CHARS=6000

# Telegram (server only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=

# Groq (server only)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Prefer a modern sb_secret_... key. Legacy service_role JWT also works.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_EMAIL=

# Dashboard public values only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
