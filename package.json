{
  "name": "mindcompanion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "setup:supabase": "node scripts/init-supabase-settings.js",
    "smoke:connections": "node scripts/check-external-services.js",
    "smoke:contract": "node scripts/check-groq-contract.js",
    "start:bot": "npm --workspace @mindcompanion/bot start",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  }
}
