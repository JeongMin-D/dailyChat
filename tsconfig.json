{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "apps/**/src/**/*.js",
    "packages/**/src/**/*.js",
    "workers/**/src/**/*.js",
    "scripts/**/*.js",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "**/test/**"]
}
